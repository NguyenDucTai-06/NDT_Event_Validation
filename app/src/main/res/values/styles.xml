<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Nhãn tiêu đề của từng dòng thông tin ở màn hình Chi tiết -->
    <style name="DetailLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- Giá trị của từng dòng thông tin ở màn hình Chi tiết -->
    <style name="DetailValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textIsSelectable">true</item>
    </style>
</resources>
